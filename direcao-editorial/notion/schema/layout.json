        { "heading": "Prioridades comerciais", "view": { "name": "Prioridades", "base": "prioridades", "type": "table", "filter": { "property": "Status", "select": { "does_not_equal": "Encerrada" } }, "show": ["Prioridade", "Período", "Status", "Procedimento ou serviço", "Meta", "Peso"] } },
        { "heading": "Calendário do mês", "view": { "name": "Calendário", "base": "conteudos", "type": "calendar", "date_property": "Publicação prevista", "show": ["Título", "Formato", "Pilar"] } },
