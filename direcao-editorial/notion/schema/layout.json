{
  "$comment": "Páginas e visualizações da Central Editorial. Lido por scripts/setup.mjs. 'show' = propriedades visíveis, na ordem; todas as outras ficam ocultas. Filtros usam o formato do endpoint de query do Notion, com nomes de propriedade (o script troca pelos IDs). 'manual' lista o que a API não cobre e precisa ser feito à mão (ver notion/06-Configuracao.md).",
  "root": { "title": "Central Editorial | Larissa Andrade", "icon": "✨" },
  "pages": [
    {
      "key": "social",
      "title": "Hoje | Social media",
      "icon": "🏠",
      "intro": "Comece por aqui. De cima para baixo: o porquê da semana, o que fazer hoje, o que pedir à Larissa e o que está travado.",
      "sections": [
        { "heading": "Intenção da semana", "view": { "name": "Semana vigente", "base": "semanas", "type": "list", "filter": { "property": "Vigente", "formula": { "checkbox": { "equals": true } } }, "show": ["Semana", "Intenção editorial", "Narrativas", "Capacidade de produção", "Restrições da semana"] } },
        { "heading": "Hoje", "view": { "name": "Direcionamento de hoje", "base": "dias", "type": "table", "filter": { "property": "É hoje", "formula": { "checkbox": { "equals": true } } }, "show": ["Dia", "Intenção do dia", "Prioridade 1", "Prioridade 2", "Prioridade 3", "Minha rotina", "Disponibilidade para gravar", "Direcionamento"] } },
        { "heading": "Stories de hoje", "view": { "name": "Stories de hoje", "base": "conteudos", "type": "list", "filter": { "and": [ { "property": "Formato", "select": { "equals": "Sequência de stories" } }, { "property": "Para hoje", "formula": { "checkbox": { "equals": true } } } ] }, "show": ["Título", "Pilar", "Objetivo", "Gancho", "Etapa"] } },
        { "heading": "Próximas publicações do feed", "view": { "name": "Próximos 14 dias", "base": "conteudos", "type": "table", "filter": { "and": [ { "property": "Dias até publicar", "formula": { "number": { "greater_than_or_equal_to": 0 } } }, { "property": "Dias até publicar", "formula": { "number": { "less_than_or_equal_to": 14 } } }, { "property": "Formato", "select": { "does_not_equal": "Sequência de stories" } } ] }, "sorts": [ { "property": "Publicação prevista", "direction": "ascending" } ], "show": ["Título", "Publicação prevista", "Formato", "Pilar", "Etapa", "Com quem está"] } },
        { "heading": "Pedir à Larissa", "view": { "name": "Materiais a pedir", "base": "captacao", "type": "table", "filter": { "and": [ { "property": "Status", "select": { "equals": "A solicitar" } }, { "property": "Quem capta", "select": { "does_not_equal": "Social media" } } ] }, "sorts": [ { "property": "Quando", "direction": "ascending" } ], "show": ["Pedido", "Tipo", "Como gravar", "Quando", "Conteúdos"] } },
        { "heading": "Aguardando edição", "view": { "name": "Em produção", "base": "conteudos", "type": "table", "filter": { "property": "Status", "status": { "equals": "Em produção" } }, "sorts": [ { "property": "Prazo de produção", "direction": "ascending" } ], "show": ["Título", "Formato", "Prazo de produção", "Publicação prevista", "Atrasado"] } },
        { "heading": "Aguardando aprovação da Larissa", "view": { "name": "Com a Larissa", "base": "conteudos", "type": "table", "filter": { "property": "Status", "status": { "equals": "Aguardando aprovação" } }, "show": ["Título", "Formato", "Publicação prevista"] } },
        { "heading": "Pendências e impedimentos", "view": { "name": "Travados", "base": "conteudos", "type": "table", "filter": { "property": "Status", "status": { "equals": "Aguardando informação" } }, "show": ["Título", "Bloqueio", "Pendências", "Informação clínica pendente"] } },
        { "heading": "Sugestões do agente para decidir", "view": { "name": "Recomendações abertas", "base": "recomendacoes", "type": "table", "filter": { "property": "Decisão", "select": { "equals": "Aguardando decisão" } }, "show": ["Recomendação", "Tipo", "Proposta", "Por quê", "Conteúdo", "Decisão"] } },
        { "heading": "Meu quadro", "view": { "name": "Quadro de produção", "base": "conteudos", "type": "board", "group_by": "Status", "filter": { "and": [ { "property": "Status", "status": { "does_not_equal": "Arquivado" } }, { "property": "Status", "status": { "does_not_equal": "Analisado" } }, { "property": "Status", "status": { "does_not_equal": "Ideia" } } ] }, "show": ["Título", "Formato", "Publicação prevista", "Com quem está"] } }
