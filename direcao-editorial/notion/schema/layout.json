        { "heading": "3. Para eu aprovar", "view": { "name": "Para eu aprovar", "base": "conteudos", "type": "gallery", "filter": { "property": "Status", "status": { "equals": "Aguardando aprovação" } }, "show": ["Título", "Formato", "Publicação prevista"] } },
        { "heading": "4. Perguntas para mim", "view": { "name": "Minhas perguntas", "base": "pendencias", "type": "list", "filter": { "and": [ { "property": "Quem responde", "select": { "equals": "Larissa" } }, { "property": "Status", "select": { "equals": "Aberta" } } ] }, "sorts": [ { "property": "Bloco do questionário", "direction": "ascending" } ], "show": ["Pendência", "Bloco do questionário", "Prioridade"] } },
        { "heading": "5. Tive uma ideia ou aconteceu algo", "view": { "name": "Registrar ideia", "base": "conteudos", "type": "form" } },
        { "heading": "6. Quero guardar um link", "view": { "name": "Guardar referência", "base": "referencias", "type": "form" } }
