        "Observações da social media": { "type": "rich_text", "owner": "social" },
        "É hoje": { "type": "formula", "owner": "sistema", "expression": "formatDate(prop(\"Data\"), \"YYYY-MM-DD\") == formatDate(today(), \"YYYY-MM-DD\")" }
      },
      "body_template": ["Direcionamento do agente", "Stories sugeridos", "Captação do dia", "Avisos"]
    },
