{
  "$comment": "Fonte única da estrutura da Central Editorial no Notion. Lido por scripts/setup.mjs, scripts/importar.mjs e scripts/validar.mjs. Documentado em notion/02-Modelo-de-dados.md. owner: quem é dono do campo (larissa | social | gestao | equipe | agente | sistema). O agente só escreve em campos 'agente' ou 'sistema'; mudanças em campos humanos viram Recomendações.",
  "notion_version": "2026-03-11",
  "origens": ["Trello", "Larissa", "Social media", "Gestão", "Agente", "Instagram", "Sistema"],
  "common_properties": {
    "ID": { "type": "unique_id", "owner": "sistema", "desc": "Identificador estável legível (prefixo por base). Nunca muda." },
    "Chave": { "type": "rich_text", "owner": "sistema", "desc": "Chave externa estável e de idempotência. Ex.: trello:C-01, pendencia:P-01, agente:planejamento-semanal:2026-W49:3. Única por base." },
    "Origem": { "type": "select", "options_from": "origens", "owner": "sistema", "desc": "Quem originou a informação (autoria lógica). Created by mostra a integração quando o n8n cria; Origem mostra de onde veio." },
    "Criado por": { "type": "created_by", "owner": "sistema" },
    "Criado em": { "type": "created_time", "owner": "sistema" },
    "Atualizado por": { "type": "last_edited_by", "owner": "sistema" },
    "Atualizado em": { "type": "last_edited_time", "owner": "sistema" }
  },
  "sync_properties": {
    "$comment": "Campos técnicos para preservar edição humana e rastrear o agente. Ficam ocultos em todas as views da equipe.",
    "Versão": { "type": "number", "owner": "sistema", "desc": "Incrementada a cada escrita do agente aplicada." },
    "Hash do agente": { "type": "rich_text", "owner": "sistema", "desc": "SHA-256 dos campos do agente na última escrita dele. Se o hash atual diferir, houve edição humana: o agente não sobrescreve." },
    "Última escrita do agente": { "type": "date", "owner": "sistema" },
    "Sincronização": { "type": "select", "owner": "sistema", "options": [["OK", "green"], ["Editado pela equipe", "blue"], ["Conflito", "orange"], ["Erro", "red"]] },
    "Execução": { "type": "relation", "target": "execucoes", "single": true, "owner": "sistema", "desc": "Última execução do n8n que escreveu nesta página." }
  },
  "databases": [
    {
      "key": "conteudos",
      "title": "Conteúdos",
      "icon": "📝",
      "prefix": "CON",
      "sync": true,
      "desc": "Fonte única de cada peça de conteúdo, inclusive ideias (Status = Ideia) e sequências de stories.",
      "properties": {
        "Título": { "type": "title", "owner": "equipe" },
        "Status": {
          "type": "status", "owner": "equipe",
          "options": [
            ["Ideia", "gray", "To-do"],
            ["Planejado", "default", "To-do"],
            ["Aguardando informação", "red", "To-do"],
            ["Aguardando captação", "orange", "To-do"],
            ["Em produção", "yellow", "In progress"],
            ["Aguardando aprovação", "purple", "In progress"],
            ["Aprovado", "blue", "In progress"],
            ["Agendado", "green", "In progress"],
            ["Publicado", "green", "Complete"],
            ["Analisado", "brown", "Complete"],
            ["Arquivado", "gray", "Complete"]
          ]
        },
        "Formato": { "type": "select", "owner": "equipe", "options": [["Reels", "pink"], ["Carrossel", "blue"], ["Sequência de stories", "orange"], ["Foto", "green"], ["A definir", "gray"]] },
        "Pilar": { "type": "select", "owner": "equipe", "options": [["Autoridade", "blue"], ["Desejo e prova social", "pink"], ["Conexão", "green"]] },
        "Objetivo": { "type": "select", "owner": "equipe", "options": [["Descoberta", "purple"], ["Engajamento", "yellow"], ["Educação", "blue"], ["Construção de confiança", "green"], ["Quebra de objeção", "orange"], ["Geração de desejo", "pink"], ["Conversão", "red"], ["Fidelização", "brown"]] },
        "Prioridade": { "type": "select", "owner": "equipe", "options": [["Alta", "red"], ["Média", "yellow"], ["Baixa", "gray"]] },
        "Com quem está": { "type": "select", "owner": "equipe", "options": [["Larissa", "pink"], ["Social media", "blue"], ["Gestão", "gray"]], "desc": "Quem precisa agir agora. Select (e não pessoa) para o n8n conseguir preencher sem IDs de usuário." },
        "Responsável": { "type": "people", "owner": "equipe", "desc": "Opcional. Pessoa no Notion, para notificações e 'Minhas tarefas'." },
        "Prazo de produção": { "type": "date", "owner": "equipe" },
        "Publicação prevista": { "type": "date", "owner": "equipe" },
        "Publicado em": { "type": "date", "owner": "social" },
        "Link da publicação": { "type": "url", "owner": "social" },
        "Gancho": { "type": "rich_text", "owner": "equipe", "desc": "Abertura curta. Roteiro, direção criativa e legenda ficam no corpo da página (limite de 2000 caracteres por campo de texto da API)." },
        "CTA": { "type": "rich_text", "owner": "equipe" },
        "Bloqueio": { "type": "rich_text", "owner": "equipe", "desc": "O que falta para avançar, em uma frase." },
        "Informação clínica pendente": { "type": "checkbox", "owner": "equipe" },
        "Autorização de imagem": { "type": "select", "owner": "equipe", "options": [["Não se aplica", "gray"], ["Pendente", "red"], ["Registrada", "green"]] },
        "Já publicado? (Trello)": { "type": "select", "owner": "social", "options": [["A confirmar", "yellow"], ["Sim", "green"], ["Não", "gray"]], "desc": "Só para o inventário de nov/2026. Nunca presumido." },
        "Notas de origem": { "type": "rich_text", "owner": "sistema", "desc": "De onde veio (lista, semana, cartão do Trello; ou mensagem da Larissa)." },
        "Relato": { "type": "rich_text", "owner": "equipe", "desc": "Texto livre de quem trouxe a ideia (formulário da Larissa ou da social media). Nunca reescrito pelo agente." },
        "Dificuldades": { "type": "rich_text", "owner": "social", "desc": "Social media registra o que travou a produção." },
        "Pedir revisão ao agente": { "type": "checkbox", "owner": "equipe", "desc": "Marcar dispara a revisão sob demanda. O n8n desmarca ao concluir." },
        "O que revisar": { "type": "rich_text", "owner": "equipe" },
        "Travar para o agente": { "type": "checkbox", "owner": "equipe", "desc": "Marcado: o agente nunca altera nem sugere mudanças nesta página." },
        "Aprovado por": { "type": "people", "owner": "larissa" },
        "Aprovado em": { "type": "date", "owner": "larissa" },
        "Semana": { "type": "relation", "target": "semanas", "dual": "Conteúdos", "owner": "equipe" },
        "Dia": { "type": "relation", "target": "dias", "dual": "Conteúdos do dia", "owner": "equipe", "desc": "Dia de produção ou de stories." },
        "Prioridade comercial": { "type": "relation", "target": "prioridades", "dual": "Conteúdos", "owner": "gestao" },
        "Captação": { "type": "relation", "target": "captacao", "dual": "Conteúdos", "owner": "equipe" },
        "Pendências": { "type": "relation", "target": "pendencias", "dual": "Conteúdos afetados", "owner": "equipe" },
        "Referências": { "type": "relation", "target": "referencias", "dual": "Conteúdos", "owner": "equipe" },
        "Métricas": { "type": "relation", "target": "metricas", "dual": "Conteúdo", "owner": "sistema" },
        "Aprendizados": { "type": "relation", "target": "aprendizados", "dual": "Evidências", "owner": "agente" },
        "Recomendações": { "type": "relation", "target": "recomendacoes", "dual": "Conteúdo", "owner": "sistema" },
        "Etapa": {
          "type": "formula", "owner": "sistema", "desc": "Status simplificado para a social media.",
          "expression": "ifs(prop(\"Status\") == \"Ideia\", \"Ideia\", [\"Planejado\", \"Aguardando informação\", \"Aguardando captação\"].includes(prop(\"Status\")), \"A fazer\", prop(\"Status\") == \"Em produção\", \"Produzindo\", prop(\"Status\") == \"Aguardando aprovação\", \"Com a Larissa\", [\"Aprovado\", \"Agendado\"].includes(prop(\"Status\")), \"Pronto\", [\"Publicado\", \"Analisado\"].includes(prop(\"Status\")), \"Publicado\", \"Arquivado\")"
        },
        "Atrasado": {
          "type": "formula", "owner": "sistema",
          "expression": "and(!empty(prop(\"Prazo de produção\")), dateBetween(today(), prop(\"Prazo de produção\"), \"days\") > 0, ![\"Aprovado\", \"Agendado\", \"Publicado\", \"Analisado\", \"Arquivado\"].includes(prop(\"Status\")))"
        },
        "Dias até publicar": {
          "type": "formula", "owner": "sistema",
          "expression": "dateBetween(prop(\"Publicação prevista\"), today(), \"days\")"
        },
        "Para hoje": {
          "type": "formula", "owner": "sistema",
          "expression": "prop(\"Dia\").filter(formatDate(current.prop(\"Data\"), \"YYYY-MM-DD\") == formatDate(today(), \"YYYY-MM-DD\")).length() > 0"
        }
      },
      "body_template": ["Roteiro", "Direção criativa", "Legenda", "Notas da equipe"]
    },
    {
      "key": "semanas",
      "title": "Semanas",
      "icon": "🗓️",
      "prefix": "SEM",
      "sync": true,
      "desc": "Planejamento semanal: intenção, narrativas, capacidade real e prioridades comerciais da semana.",
      "properties": {
        "Semana": { "type": "title", "owner": "sistema", "desc": "Ex.: 2026-W49 · 30/11 a 06/12" },
        "Período": { "type": "date", "owner": "sistema" },
        "Status do plano": { "type": "select", "owner": "gestao", "options": [["Rascunho do agente", "gray"], ["Em revisão", "yellow"], ["Aprovado", "green"], ["Encerrado", "brown"]] },
        "Intenção editorial": { "type": "rich_text", "owner": "agente" },
        "Narrativas": { "type": "rich_text", "owner": "agente" },
        "Capacidade de produção": { "type": "select", "owner": "gestao", "options": [["Normal", "green"], ["Reduzida", "yellow"], ["Mínima", "red"]] },
        "Restrições da semana": { "type": "rich_text", "owner": "gestao", "desc": "Viagem, agenda cheia, feriado, campanha." },
        "Revisão de sexta": { "type": "rich_text", "owner": "agente" },
        "Prioridades comerciais": { "type": "relation", "target": "prioridades", "dual": "Semanas", "owner": "gestao" },
        "Vigente": { "type": "formula", "owner": "sistema", "expression": "and(formatDate(dateStart(prop(\"Período\")), \"YYYY-MM-DD\") <= formatDate(today(), \"YYYY-MM-DD\"), formatDate(dateEnd(prop(\"Período\")), \"YYYY-MM-DD\") >= formatDate(today(), \"YYYY-MM-DD\"))" },
        "Planejados": { "type": "formula", "owner": "sistema", "expression": "prop(\"Conteúdos\").filter(![\"Ideia\", \"Arquivado\"].includes(current.prop(\"Status\"))).length()" },
        "Publicados": { "type": "formula", "owner": "sistema", "expression": "prop(\"Conteúdos\").filter([\"Publicado\", \"Analisado\"].includes(current.prop(\"Status\"))).length()" }
      }
    },
