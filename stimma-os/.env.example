# ==========================================================================
# Supabase (obrigatorio para conectar dados reais)
# ==========================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. NUNCA exposta ao navegador. Usada apenas em Route
# Handlers/Server Actions de confianca (sync, automacoes, aprovacoes).
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================================================
# Modo demonstracao
# ==========================================================================
# Enquanto NEXT_PUBLIC_SUPABASE_URL nao estiver configurada, o STIMMA OS
# roda em modo demonstracao com dados fictícios (ver lib/seed/seed-data.ts)
# para permitir desenvolver e testar a interface sem banco real.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================================================
# Sync Engine (Fase 4)
# ==========================================================================
# Segredo compartilhado para chamar POST /api/sync/agenda. Gere uma string
# aleatoria longa (ex.: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
SYNC_API_SECRET=

# ==========================================================================
# WhatsApp / Chatwoot (Fase 9 — ver docs/WHATSAPP_ARCHITECTURE.md)
# ==========================================================================
# 'mock' (padrao, nunca envia mensagem real) ou 'chatwoot' quando uma
# instancia Chatwoot self-hosted existir.
WHATSAPP_PROVIDER=mock

# Obrigatorias apenas quando WHATSAPP_PROVIDER=chatwoot.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_ACCESS_TOKEN=

# Secret do webhook configurado no Chatwoot (Configuracoes > Integracoes >
# Webhooks) — usado para verificar a assinatura HMAC de cada evento recebido
# em POST /api/webhooks/chatwoot. Sem isso, o endpoint recusa toda requisicao.
CHATWOOT_WEBHOOK_SECRET=
